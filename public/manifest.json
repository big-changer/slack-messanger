{
  "manifest_version": 3,
  "name": "Slack Scrapping Extension",
  "version": "1.0.0",
  "description": "A Chrome extension for Slack scraping built with TypeScript and React",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.slack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.slack.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slack Scrapping Extension"
  }
}
